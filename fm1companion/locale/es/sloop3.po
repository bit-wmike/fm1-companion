msgstr "no hay nada ahí"

#: fm1companion/sloop3.py:79
msgid "check failed"
msgstr "comprobación fallida"

#: fm1companion/sloop3.py:79
msgid "not a SLOOP 3 file"
msgstr "no es un archivo de SLOOP 3"

#: fm1companion/sloop3.py:181
msgid "SLOOP 3's answer is too short"
msgstr "La respuesta de SLOOP 3 es demasiado corta"

#: fm1companion/sloop3.py:184
msgid "SLOOP 3's answer names no version"
msgstr "La respuesta de SLOOP 3 no indica ninguna versión"

