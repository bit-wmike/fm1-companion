#: fm1companion/sloop3bk.py:43
msgid "Settings (kept to look at, not restored)"
msgstr "Ajustes (se conservan para consultarlos, no se restauran)"

#: fm1companion/sloop3bk.py:108
msgid "Not a SLOOP 3 backup"
msgstr "No es una copia de seguridad de SLOOP 3"

#: fm1companion/sloop3bk.py:129
msgid "The backup does not contain a project"
msgstr "La copia de seguridad no contiene ningún proyecto"

#: fm1companion/sloop3bk.py:189
#: fm1companion/sloop3bk.py:195
#, python-brace-format
msgid "{part}: the FM-1 holds something else than was written."
msgstr "{part}: el FM-1 contiene algo distinto de lo que se escribió."

