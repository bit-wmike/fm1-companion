msgstr "falta el editor de SLOOP 3 incluido"

#: fm1companion/sloop3bk.py:41
msgid "Project saved on the FM-1"
msgstr "Proyecto guardado en el FM-1"

#: fm1companion/sloop3bk.py:41
msgid "Your sounds (with favourites and theme)"
msgstr "Tus sonidos (con favoritos y tema)"

#: fm1companion/sloop3bk.py:42
msgid "Project as it was at that moment (unsaved changes too)"
msgstr "Proyecto tal como estaba en ese momento (también los cambios sin guardar)"

#: fm1companion/sloop3bk.py:42
msgid "Your FM6 bank"
msgstr "Tu banco FM6"

#: fm1companion/sloop3bk.py:43
msgid "Your SYN kits"
