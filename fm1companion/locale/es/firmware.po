msgstr "No es posible: ver arriba"

#: fm1companion/ui/firmware_page.py:317
msgid "<b>Do not unplug and do not switch off now.</b> The FM-1 is writing its firmware. This takes a few minutes – after that it restarts by itself."
msgstr "<b>No desconectes ni apagues nada ahora.</b> El FM-1 está escribiendo su firmware. Tarda unos minutos; después se reinicia solo."

