#: fm1companion/ui/device.py:322
msgid "connected – SLOOP 3: its own editor and backups (pages “Editor” and “Backups”)"
msgstr "verbunden – SLOOP 3: eigener Editor und eigene Backups (Seiten „Editor“ und „Backups“)"

#: fm1companion/ui/device.py:517
#, python-brace-format
msgid "FM-1 connected – {firmware} (public beta). Its own web editor is on the page “Editor”, backups of its project, sounds and banks on the page “Backups”; the other device pages need the Felucca editor protocol, which SLOOP 3 does not speak."
msgstr "FM-1 verbunden – {firmware} (öffentliche Beta). Sein eigener Web-Editor ist auf der Seite „Editor“, Backups von Projekt, Sounds und Bänken auf der Seite „Backups“; die anderen Geräteseiten brauchen das Felucca-Editor-Protokoll, das SLOOP 3 nicht spricht."

#: fm1companion/ui/device.py:521
#, python-brace-format
msgid "FM-1 connected – {firmware} (public beta). The app was checked with SLOOP 3 {versions}, not with this version: the editor and backups may not fit it."
msgstr "FM-1 verbunden – {firmware} (öffentliche Beta). Die App wurde mit SLOOP 3 {versions} geprüft, nicht mit dieser Version: Editor und Backups passen vielleicht nicht dazu."

#: fm1companion/ui/device.py:633
#, python-brace-format
msgid "This FM-1 is in m-bootloader's MIDI MODE (m-bootloader {version}, flash chip {chip}): no firmware is running. “Firmware+” › SLOOP 3 explains what is possible from here; OCT−, OCT+, PLAY or REC on the FM-1 go back to its menu."
msgstr "Dieser FM-1 ist im MIDI MODE von m-bootloader (m-bootloader {version}, Flash-Chip {chip}): Es läuft keine Firmware. „Firmware+“ › SLOOP 3 erklärt, was von hier aus geht; OCT−, OCT+, PLAY oder REC am FM-1 führen zurück in sein Menü."

#: fm1companion/ui/editor_page.py:147
#, python-brace-format
msgid "The bundled SLOOP 3 editor is not complete: {problems}"
msgstr "Der mitgelieferte SLOOP-3-Editor ist nicht vollständig: {problems}"

#: fm1companion/ui/editor_page.py:150
#, python-brace-format
msgid "The SLOOP 3 editor that comes with the app is missing or was changed ({problems}). Please install the app again.<br><br>The author's editor online: {link}"
msgstr "Der SLOOP-3-Editor, der zur App gehört, fehlt oder wurde verändert ({problems}). Bitte installiere die App neu.<br><br>Der Editor des Autors online: {link}"

#: fm1companion/ui/editor_page.py:155
#, python-brace-format
msgid "Editor: {name} (public beta) · the author's editor, bundled · MIDI via the app"
msgstr "Editor: {name} (öffentliche Beta) · der Editor des Autors, mitgeliefert · MIDI über die App"

#: fm1companion/ui/editor_page.py:158
#, python-brace-format
msgid "this is the editor of SLOOP 3 {versions} – it may not fit your version"
msgstr "das ist der Editor von SLOOP 3 {versions} – er passt vielleicht nicht zu deiner Version"

#: fm1companion/ui/firmware_page.py:528
msgid "Not from the running SLOOP 3"
msgstr "Nicht aus dem laufenden SLOOP 3"

#: fm1companion/ui/firmware_page.py:1141
msgid "public beta"
msgstr "öffentliche Beta"

#: fm1companion/ui/firmware_page.py:1179
msgid "SLOOP 3 is not installed by the app: this shows the way onto the FM-1 (m-bootloader, flash backup, the author's installer page)."
msgstr "SLOOP 3 wird nicht von der App installiert: Das hier zeigt den Weg auf den FM-1 (m-bootloader, Flash-Backup, die Installer-Seite des Autors)."

#: fm1companion/ui/firmware_page.py:1182
msgid "SLOOP 3 has no package to download: its installer page carries the firmware."
msgstr "SLOOP 3 hat kein Paket zum Herunterladen: Seine Installer-Seite bringt die Firmware mit."

#: fm1companion/ui/overview.py:190
msgid "m-bootloader – MIDI MODE (no firmware running)"
msgstr "m-bootloader – MIDI MODE (es läuft keine Firmware)"

#: fm1companion/ui/overview.py:202
#, python-brace-format
msgid "m-bootloader {version} · flash chip {chip}"
msgstr "m-bootloader {version} · Flash-Chip {chip}"

#: fm1companion/ui/overview.py:206
#, python-brace-format
