msgstr "dort ist nichts"

#: fm1companion/sloop3.py:79
msgid "check failed"
msgstr "Prüfung fehlgeschlagen"

#: fm1companion/sloop3.py:79
msgid "not a SLOOP 3 file"
msgstr "keine SLOOP-3-Datei"

#: fm1companion/sloop3.py:181
msgid "SLOOP 3's answer is too short"
msgstr "Die Antwort von SLOOP 3 ist zu kurz"

#: fm1companion/sloop3.py:184
