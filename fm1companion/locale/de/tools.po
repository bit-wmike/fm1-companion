msgstr "<b>Gefunden:</b> {port} – {firmware}"

#: fm1companion/ui/wizard.py:230
msgid "An FM-1 is waiting in <b>update mode</b>. After the wizard, continue on the page “Recovery” – there the interrupted installation is completed."
msgstr "Ein FM-1 wartet im <b>Update-Modus</b>. Nach dem Assistenten geht es auf der Seite „Rettung“ weiter – dort wird die unterbrochene Installation abgeschlossen."

#: fm1companion/ui/wizard.py:234
msgid "FM-1 found, but it does not answer (yet) – one moment. If it does not answer at all: check the data cable, close other MIDI programs."
msgstr "FM-1 gefunden, es antwortet aber (noch) nicht – einen Moment. Antwortet es gar nicht: Datenkabel prüfen, andere MIDI-Programme schließen."

#: fm1companion/ui/wizard.py:238
msgid "No FM-1 connected yet. You can also skip this step."
msgstr "Noch kein FM-1 verbunden. Du kannst diesen Schritt auch überspringen."

#: fm1companion/ui/wizard.py:249
