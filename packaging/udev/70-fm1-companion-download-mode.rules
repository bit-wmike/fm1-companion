# FM-1 Companion Suite – let the person at the computer reach an M-VAVE FM-1 in ROM download mode.
#
# In ROM download mode the FM-1 is a USB disk "WL82 UBOOT1.00" (USB 4c4a:8057). The bundled M-Flasher talks to it
# through Linux's SCSI generic driver (/dev/sgN). TAG+="uaccess" gives the user logged in at this computer (the
# local, active seat – not a login over SSH) access to that device, so no administrator password is needed for
# every run. The lines are the same as M-Flasher's own linux/70-m-flasher.rules. Nothing else changes.
# Installed by the Debian package (/usr/lib/udev/rules.d), by install.sh and the graphical installer
# (/etc/udev/rules.d, asks for sudo); together with fm1-companion-sg.conf, which loads the `sg` driver at boot.
# Removed by `sudo apt remove fm1-companion`, or uninstall.sh. By hand:
#   sudo rm /etc/udev/rules.d/70-fm1-companion-download-mode.rules /etc/modules-load.d/fm1-companion-sg.conf
#   sudo udevadm control --reload-rules

SUBSYSTEM=="scsi_generic", ATTRS{idVendor}=="4c4a", ATTRS{idProduct}=="8057", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="4c4a", ATTR{idProduct}=="8057", TAG+="uaccess"
